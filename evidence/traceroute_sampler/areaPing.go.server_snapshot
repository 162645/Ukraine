func Traceroute(goId int) {
	// 00-01, 01-10, 10-11
	// 1-64, 65-128, 129-192, 192-254
	for {
		data := <-traceChan
		netId := data.netId
		startTimestamp := data.sendTs
		round := data.round
		var resultMap map[string][]string
		resultMap = map[string][]string{}
		start := time.Now()
		//没有采用并发进行mtr
		for i := 0; i < 4; i++ {
			var output []*traceroute.Hop
			var err error
			var tracehostId int
			var sendTimestamps []int64
			rand.Seed(time.Now().UnixNano())
			if i == 0 {
				tracehostId = rand.Intn(63) + 1
			} else if i == 1 {
				tracehostId = rand.Intn(63) + 65
			} else if i == 2 {
				tracehostId = rand.Intn(63) + 129
			} else if i == 3 {
				tracehostId = rand.Intn(63) + 192
			}
			traceIp := netId + "." + strconv.Itoa(tracehostId)
			output, sendTimestamps, err = traceroute.Trace(net.ParseIP(traceIp))
			sendTimestampsCopy := make([]int64, len(sendTimestamps))
			copy(sendTimestampsCopy, sendTimestamps)
			if err != nil {
				logger.Error("trace", zap.Error(err))
			}
			mb := &pb.MeasurementBaseInfo{
				RecvTimestampMillisecond: startTimestamp * 1000, // notify, it's start-timestamp
				Host:                     host,
				Destination:              traceIp,
				Protocol:                 pb.ProbeProtocol_ICMP,
				Round:                    int32(round),
				MeasurementPrefix:        measurementPrefix,
			}
			length := len(output)
			if length != 0 {
				hop := output[length-1]
				result := make([]string, hop.Distance)
				for i := 0; i < len(result); i++ {
					result[i] = strconv.Itoa(i+1) + ":*"
				}
				for _, h := range output {
					for _, n := range h.Nodes {
						rtt := 0.0
						for _, r := range n.RTT {
							rtt += float64(r.Nanoseconds()) / 1e6
						}
						rtt = rtt / float64(len(n.RTT))
						// "1:148.153.93.9:-1:1.2:sendtimestamp:ttl"
						if h.Distance-1 >= 32 {
							continue
						}
						var sendts int64 = 0
						if h.Distance-1 < len(sendTimestampsCopy) {
							sendts = sendTimestampsCopy[h.Distance-1]
						}
						result[h.Distance-1] = strconv.Itoa(h.Distance) + ":" + n.IP.String() + ":" + "-1" + ":" +
							fmt.Sprintf("%.2f", rtt) + ":" + fmt.Sprintf("%d", sendts) + ":" + fmt.Sprintf("%d", n.TTL)
						_, err = storeDB.SendTraceData(context.TODO(), &pb.TransferTraceRequest{
							MeasurementBaseResult: mb,
							ResponseIP:            n.IP.String(),
							Hop:                   int32(h.Distance),
							RttMillisecond:        float32(rtt),
						})
						if err != nil {
							logger.Error("storeDB.SendTraceData error ", zap.Error(err))
						}
						//strconv.FormatFloat(rtt, 'E', -1, 64)
						//fmt.Printf("%d. %v %v\n", h.Distance, n.IP, n.RTT)
					}
				}
				sendTimestampsCopy = nil
				sendTimestamps = nil
				resultMap[traceIp] = result
			}
		}

		logger.Info("TraceRoute", zap.String("C段", netId+".0"),
			zap.Float64("耗时 ms", float64(time.Since(start))/1e6),
			zap.Int("已Trace数量", len(resultMap)),
			zap.Int("Channel剩余", len(traceChan)),
			zap.Int("GoId", goId))
		if len(resultMap) != 0 {
			tmp, err := json.Marshal(resultMap)
			if err != nil {
				panic(err)
			}
			var traceResult = string(tmp)
			traceResult = netId + ".0\t" + traceResult + "\t" + fmt.Sprintf("%d", startTimestamp) + "\n"
			//logger.Debug(netId + ".0 TraceRoute done.")

			// 可以优化成只有管道+单个协程
			storeFile.SaveTraceData(netId, traceResult, round)
		}
	}
}
