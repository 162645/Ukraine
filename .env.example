# Copy to .env.local and source it before running. Never commit real credentials.
export UR_CH_HOST="127.0.0.1"
export UR_CH_HTTP_PORT="8123"
export UR_CH_NATIVE_PORT="9000"
export UR_CH_USER="readonly_user"
export UR_CH_PASSWORD="CHANGE_ME"
export UR_CH_DATABASE="net_measure"
export UR_CH_SECURE="false"
export UR_CH_CONNECT_TIMEOUT="15"
export UR_CH_SEND_RECEIVE_TIMEOUT="3600"
# Set to 0 when the remote read-only account is forbidden from changing ClickHouse settings.
# The client also retries automatically without settings after a restricted-account error.
export UR_CH_APPLY_SETTINGS="0"
